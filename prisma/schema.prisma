// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  // relationJoins: een query met relaties (include, geneste select) gaat als
  // één SQL-query met joins naar de database, in plaats van één query per
  // relatie. Scheelt roundtrips naar Supabase bij vrijwel elk scherm.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int           @id @default(autoincrement())
  username               String        @unique
  password               String? // Optioneel - null als wachtwoord nog niet gezet is
  role                   String // "admin", "user" of "alleen_lezen" (zie lib/roles.ts)
  // Alleen voor de rol "alleen lezen": welk analysejaar deze gebruiker mag zien.
  // Leeg betekent alle jaren. Wordt serverside afgedwongen in de monsterroutes,
  // niet alleen in de schermen.
  viewYear               Int?
  requiresPasswordChange Boolean       @default(true) // Moet gebruiker wachtwoord instellen?
  // Bij de rol alleen lezen: de klant waarvoor deze gebruiker meekijkt. Sinds
  // fase 3 ziet zo'n gebruiker alleen de monsters, objecten, planning en foto's
  // van die klant (lib/afscherming.ts), en daarbinnen alleen zijn viewYear.
  klantId                Int?
  klant                  Klant?        @relation(fields: [klantId], references: [id], onDelete: SetNull)
  // Wat een kijker te zien krijgt: "klassiek" (de oude monsterlijst met de navy
  // balk, zoals de Mourik-kijker hem kent) of "klantportaal". Bestaande
  // gebruikers blijven klassiek; Roel zet het per gebruiker om.
  portaalWeergave        String        @default("klassiek")
  createdAt              DateTime      @default(now())
  uitnodigingen          Uitnodiging[]
  auditLogs              AuditLog[]
  agendaFeed             AgendaFeed?

  @@index([klantId])
}

// Eenmalige link om een wachtwoord in te stellen (nieuwe gebruiker of reset).
// De beheerder kopieert de link en verstuurt hem zelf. In de database staat
// alleen de SHA-256 van het token, nooit het token zelf. Een aparte tabel en
// geen kolommen op User, zodat het inloggen van bestaande gebruikers niet raakt
// aan iets dat pas na ./db-push-fase0.sh bestaat.
model Uitnodiging {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  verlooptOp  DateTime
  gebruiktOp  DateTime?
  gemaaktDoor String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model OilSample {
  id                  Int       @id @default(autoincrement())
  oNumber             String // o-nummer, uniek per analyse-jaar (zie @@unique)
  analysisYear        Int       @default(2025) // analyse-jaar (2025, 2026, ...)
  sampleDate          DateTime? // cache: datum van de meest recente poging (SampleAttempt)
  location            String // locatie
  description         String // omschrijving
  oilType             String? // type olie (optioneel)
  remarks             String? // cache: opmerking van de meest recente poging
  isTaken             Boolean // of er een geldig genomen monster is (true = groen, false = rood)
  isDisabled          Boolean   @default(false) // monster is geannuleerd/niet nodig (grijze status)
  photoUrl            String? // cache: foto van het monsterpotje, van de meest recente poging
  partPhotoUrl        String? // cache: foto van het onderdeel waar het monster vandaan komt
  objectId            Int? // object waar dit monster bij hoort (planning); location blijft bestaan
  // Alleen voor een monster ZONDER object: bij welke klant het hoort. Met een
  // object telt de klant van het object en wordt dit veld genegeerd (zie
  // lib/afscherming.ts). De migratie fase3 zet het op Mourik voor de oude
  // monsters zonder object, zodat de Mourik-kijker die blijft zien.
  klantId             Int?
  installatieId       Int? // optioneel: de installatie op dat object (pomp, aggregaat, ...)
  // Annuleren met reden. Deze velden blijven buiten de synchronisatie met de
  // pogingen (lib/sampleAttempts.ts), anders worden ze overschreven zodra er
  // een hermonstering bijkomt. Vroeger stond de reden in `remarks` en verdween hij daar stilletjes.
  cancelReason        String? // reden uit de vaste lijst, of de toelichting bij "anders"
  cancelledAt         DateTime? // wanneer geannuleerd
  cancelledBy         String? // gebruikersnaam
  cancelReasonInPdf   Boolean   @default(true) // reden meenemen in de PDF voor de klant
  // Niet bereikbaar: de locatie was door afzetting, andere werkzaamheden of
  // begroeiing niet te bereiken. Dit is iets anders dan geannuleerd: het monster
  // blijft openstaan (isDisabled blijft false) en blijft dus meetellen in de
  // planning, want het moet waarschijnlijk alsnog gebeuren. Net als bij het
  // annuleren blijven deze velden buiten de synchronisatie met de pogingen
  // (lib/sampleAttempts.ts), zodat een hermonstering ze niet overschrijft.
  isUnreachable       Boolean   @default(false) // staat nu als niet bereikbaar te boek
  unreachableReason   String? // reden uit de vaste lijst, of de toelichting bij "anders"
  unreachableNote     String? // korte omschrijving van de situatie
  unreachablePhotoUrl String? // eigen foto als bewijs
  unreachableAt       DateTime? // wanneer vastgelegd
  unreachableBy       String? // gebruikersnaam
  // Zacht verwijderen: een verwijderd monster blijft met pogingen en al in de
  // database staan en gaat naar de prullenbak (admin, per jaar), waar je het
  // terugzet. Alle lijsten, tellingen, de planning en de PDF slaan monsters met
  // een deletedAt over (lib/verwijderdeMonsters.ts). Het O-nummer blijft bezet
  // zolang het monster in de prullenbak staat, want @@unique hieronder geldt ook
  // voor verwijderde monsters.
  deletedAt           DateTime? // wanneer verwijderd; leeg = gewoon in de lijst
  deletedBy           String? // gebruikersnaam
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attempts    SampleAttempt[]
  object      SampleObject?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  installatie Installatie?    @relation(fields: [installatieId], references: [id], onDelete: SetNull)
  klant       Klant?          @relation(fields: [klantId], references: [id], onDelete: SetNull)

  @@unique([oNumber, analysisYear])
  @@index([analysisYear])
  @@index([objectId])
  @@index([klantId])
  @@index([installatieId])
  @@index([deletedAt])
}

// ============================================
// PLANNING: OBJECTEN
// ============================================
// Een object is de plek waar je monsters neemt: een sluis, stuw, gemaal of ander
// kunstwerk. Objecten zijn jaaroverstijgend, want dezelfde sluis komt in 2025 en
// 2026 terug. Het adres komt uit de PDOK-adreszoeker; de speld mag daarna
// verschoven worden naar de plek waar je echt moet zijn (bijvoorbeeld het
// sluishoofd in plaats van het bezoekadres). `estimatedMinutes` is de geschatte
// tijd die je op dit object kwijt bent, inclusief opstarten.
//
// Het vrije tekstveld `location` op OilSample blijft naast `objectId` bestaan,
// zodat oude gegevens en de PDF blijven werken.

model SampleObject {
  id               Int      @id @default(autoincrement())
  name             String   @unique // bijv. "Sluis Grave"
  region           String? // bijv. "Maas" of "Zuid-Willemsvaart"
  objectType       String? // sluis, stuw, brug, gemaal, ... (zie lib/sampleObjects.ts)
  address          String? // adres zoals gevonden via PDOK
  lat              Float? // speld op de kaart, mag verschoven worden
  lng              Float?
  estimatedMinutes Int? // geschatte werktijd op locatie, in minuten
  notes            String?
  klantId          Int? // de klant waar dit object bij hoort
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  klant         Klant?           @relation(fields: [klantId], references: [id], onDelete: SetNull)
  samples       OilSample[]
  stops         SamplePlanStop[]
  installaties  Installatie[]
  inspecties    Inspectie[]
  contractTaken ContractTaak[]
  dagrapporten  Dagrapport[]

  @@index([region])
  @@index([klantId])
}

// ============================================
// PLANNING: DAGEN EN STOPS
// ============================================
// Een SamplePlan is een dag waarop je op pad gaat. De objecten die je die dag
// bezoekt staan als SamplePlanStop in de gekozen volgorde. De route over de weg
// (OSRM) wordt per dag bewaard: het traject, de afstand en, nieuw ten opzichte
// van de controlerondes, ook de rijtijd. Bij storing van die dienst valt de
// planning terug op rechte lijnen en blijft hij gewoon werken.

model SamplePlan {
  id            Int      @id @default(autoincrement())
  date          DateTime // de dag zelf (zonder tijd)
  analysisYear  Int // 2025, 2026, ...
  notes         String?
  routeGeometry String? // cache: rij-traject als GeoJSON-coords [[lng,lat],...]
  routeDistance Float? // cache: afstand in meters
  routeDuration Float? // cache: rijtijd in seconden
  manualOrder   Boolean  @default(false) // volgorde met de hand gezet; niet meer automatisch herschikken
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stops        SamplePlanStop[]
  dagrapporten Dagrapport[]

  @@unique([date, analysisYear])
  @@index([analysisYear])
}

// Een object op een dag. `sampleIds` is een JSON-lijst met de monsters die je dat
// bezoek meeneemt; leeg betekent: alle openstaande monsters van dit object. Zo kun
// je een object met veel monsters over twee dagen splitsen en weet je in het veld
// welke monsters bij welke dag horen. start- en eindtijd vullen zich in het
// dagscherm, zodat de werkelijke tijd naast je inschatting komt te staan.

model SamplePlanStop {
  id             Int       @id @default(autoincrement())
  planId         Int
  objectId       Int
  sampleIds      String? // JSON: [12, 13, 14]; null of leeg = alles wat openstaat
  orderIndex     Int       @default(0)
  plannedMinutes Int? // inschatting voor dit bezoek; leeg = die van het object
  isDone         Boolean   @default(false)
  doneAt         DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  // Sinds fase 5 kan een stop ook een contracttaak of een inspectiebezoek zijn
  // in plaats van oliemonsters. Het object blijft verplicht (van de taak of de
  // inspectie), zodat de route en de dagtotalen hetzelfde blijven rekenen.
  // Beide leeg = een gewone oliemonsterstop, zoals altijd.
  taakId         Int?
  inspectieId    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plan      SamplePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  object    SampleObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  taak      ContractTaak? @relation(fields: [taakId], references: [id], onDelete: Cascade)
  inspectie Inspectie?    @relation(fields: [inspectieId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([objectId])
  @@index([orderIndex])
  @@index([taakId])
  @@index([inspectieId])
}

// Per OilSample kunnen er meerdere monsternames (pogingen) zijn.
// Elke poging heeft eigen datum, foto en opmerking.
// De "meest recente" poging wordt als cache gespiegeld naar OilSample
// zodat bestaande lees-code gewoon blijft werken.
model SampleAttempt {
  id           Int       @id @default(autoincrement())
  oilSampleId  Int
  sampleDate   DateTime? // datum afname; null = gepland maar nog niet genomen
  photoUrl     String? // foto van het monsterpotje bij deze poging
  partPhotoUrl String? // foto van het onderdeel waar het monster vandaan komt
  remarks      String? // opmerkingen specifiek voor deze poging
  isTaken      Boolean   @default(false) // of deze poging daadwerkelijk is afgenomen
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  oilSample OilSample @relation(fields: [oilSampleId], references: [id], onDelete: Cascade)

  @@index([oilSampleId])
  @@index([sampleDate])
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique // Settings key (bijv. "theme", "columns")
  value     String // JSON string met de settings waarde
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int? // Optioneel - bij login failures is er geen userId
  username  String // Gebruikersnaam voor makkelijk filteren
  action    String // Bijv. "LOGIN", "CREATE_SAMPLE", "DELETE_USER"
  details   String? // JSON string met extra details
  ipAddress String? // IP adres van de request
  userAgent String? // Browser/device info
  success   Boolean  @default(true) // Of de actie geslaagd is
  createdAt DateTime @default(now())

  // Echte koppeling met de gebruiker. Wordt die verwijderd, dan blijft de regel
  // staan met de gebruikersnaam als tekst (username hierboven).
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// ACQUISITIE
// ============================================
// Werkbank voor het binnenhalen van nieuwe vaste klanten: wie benader ik,
// wanneer, en wat kwam eruit. Een Prospect is een bedrijf dat interessant is;
// elk contactmoment (mail, LinkedIn, gesprek, offerte) komt als losse regel in
// de tijdlijn. De velden bedrijfsnaam t/m afstandKm komen uit het vaste
// kolomformaat van de prospectlijst (acquisitie/data/VELDEN.md), zodat een CSV
// uit het onderzoek een-op-een geimporteerd kan worden.

enum ProspectStatus {
  NIEUW // net binnen uit de lijst, nog niets mee gedaan
  ONDERZOCHT // uitgezocht, klaar om te benaderen
  BENADERD // mail of LinkedIn verstuurd, wacht op reactie
  REACTIE // ze hebben gereageerd
  GESPREK // gesprek gehad of gepland
  OFFERTE // offerte de deur uit
  KLANT // binnen als klant
  AFGEWEZEN // gaat niet door
  LATER // interessant, maar nu even niet
}

enum ProspectKanaal {
  MAIL
  LINKEDIN
  TELEFOON
  BEZOEK
  OFFERTE
  OVERIG
}

model Prospect {
  id              Int     @id @default(autoincrement())
  bedrijfsnaam    String
  segment         String? // industrie / dienstverlener / overheid
  plaats          String
  provincie       String?
  website         String?
  telefoon        String?
  email           String?
  contactpersoon  String?
  functie         String?
  linkedin        String?
  omvang          String? // schatting aantal medewerkers, bv "50-100"
  activiteit      String? // een zin: wat doen ze
  aanknopingspunt String? // de reden waarom dit bedrijf mij nodig heeft
  signaal         String? // recent nieuws, vacature, uitbreiding, met datum
  bron            String? // URL waar aanknopingspunt en signaal vandaan komen
  score           Int? // 1-5, 5 = beste match
  scoreReden      String?
  afstandKm       Float? // hemelsbreed vanaf Heeze

  status           ProspectStatus @default(NIEUW)
  kanaal           ProspectKanaal @default(MAIL) // via welk kanaal je dit bedrijf benadert: MAIL of LINKEDIN, één tegelijk
  afgemeldOp       DateTime? // datum waarop ze aangaven geen mail meer te willen (eis uit het e-mailrecht)
  volgendeActie    String? // wat is de eerstvolgende stap
  volgendeActieOp  DateTime? // wanneer die stap moet gebeuren
  laatsteContactOp DateTime? // cache: datum van het laatste contactmoment
  klantSindsOp     DateTime? // gezet zodra de status op KLANT komt (voor "nieuwe klanten dit kwartaal")
  geschatteWaarde  Int? // in hele euro's
  notities         String?
  archief          Boolean        @default(false)
  // Gezet door de actie Wordt klant: de klant die uit deze prospect is ontstaan.
  klantId          Int?           @unique
  klant            Klant?         @relation(fields: [klantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactmomenten ProspectContactmoment[]

  // Voorkomt dubbelen bij het importeren van een prospectlijst
  @@unique([bedrijfsnaam, plaats])
  @@index([status])
  @@index([segment])
  @@index([volgendeActieOp])
}

model ProspectContactmoment {
  id             Int            @id @default(autoincrement())
  prospectId     Int
  datum          DateTime // wanneer het contact was
  kanaal         ProspectKanaal @default(MAIL)
  samenvatting   String // wat je gedaan of gestuurd hebt
  uitkomst       String? // wat eruit kwam
  aangemaaktDoor String? // gebruikersnaam
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([datum])
}

// ============================================
// KLANTEN
// ============================================
// De kern van de portal: een klant, met contactpersonen, objecten (vestiging,
// kunstwerk of locatie, het bestaande SampleObject) en op een object eventueel
// installaties. Mourik Infra B.V. is de eerste klant; de migratie
// klanten_en_installaties koppelt alle bestaande objecten en kijkers daaraan.
//
// Verwijderen is zacht (deletedAt), net als bij de oliemonsters: de gegevens
// blijven staan en zijn terug te zetten.

model Klant {
  id                  Int       @id @default(autoincrement())
  naam                String
  adres               String? // straat en huisnummer
  postcode            String?
  plaats              String?
  kvkNummer           String?
  notities            String?
  // Logo voor het klantportaal en het rapport: een pad in /public
  // (/mourik_logo.png) of een foto in de Blob-opslag.
  logoUrl             String?
  // Werkbonnen voor deze klant standaard laten tekenen. Uit bij een klant die
  // geen handtekening vraagt (Mourik, oliemonsters): de werkbon wordt dan
  // afgerond zonder handtekening. Per werkbon te veranderen.
  werkbonHandtekening Boolean   @default(true)
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  contactpersonen Contactpersoon[]
  objecten        SampleObject[]
  gebruikers      User[]
  prospect        Prospect?
  losseMonsters   OilSample[]
  inspecties      Inspectie[]
  contracten      Contract[]
  dagrapporten    Dagrapport[]

  @@index([naam])
  @@index([deletedAt])
}

model Contactpersoon {
  id        Int       @id @default(autoincrement())
  klantId   Int
  naam      String
  functie   String?
  email     String?
  telefoon  String?
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  klant Klant @relation(fields: [klantId], references: [id], onDelete: Cascade)

  @@index([klantId])
}

// Een installatie op een object: pomp, hydraulisch aggregaat, compressor, pers.
// `code` is een korte, unieke code voor een latere QR-sticker (lib/installaties.ts).
model Installatie {
  id          Int       @id @default(autoincrement())
  objectId    Int
  code        String    @unique
  naam        String // bijv. "Aggregaat hefdeur boven"
  soort       String // pomp, aggregaat, compressor, pers, overig (lib/installaties.ts)
  merk        String?
  typenummer  String?
  bouwjaar    Int?
  serienummer String?
  fotoUrl     String?
  notities    String?
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  object         SampleObject    @relation(fields: [objectId], references: [id], onDelete: Restrict)
  monsters       OilSample[]
  inspecties     Inspectie[]
  inspectieItems InspectieItem[]
  contractTaken  ContractTaak[]

  @@index([objectId])
  @@index([deletedAt])
}

// ============================================
// INSPECTIES (fase 4)
// ============================================
// Eén generiek model voor elke inspectie met rapport. Wat er per bevinding
// wordt vastgelegd en hoe er gerekend wordt, staat in een sjabloon in de code
// (lib/inspecties/sjablonen.ts): persluchtlekken en inspectie arbeidsmiddelen.
// Sjabloonspecifieke getallen staan als JSON in `instellingen` (op de
// inspectie) en `waarden` (per bevinding); de API controleert ze met zod.
//
// De klant staat op de inspectie zelf: daarop gaat de afscherming per klant
// (een kijker met het klantportaal ziet alleen de afgeronde inspecties van zijn
// klant). Verwijderen is zacht, net als bij klanten en monsters.

model Inspectie {
  id            Int       @id @default(autoincrement())
  // Nummer INS-2026-001: jaar van de datum bij aanmaken en volgnummer in dat
  // jaar, vast bij aanmaken (lib/nummering.ts). Leeg: oud nummer INS-12.
  nummerJaar    Int?
  volgnummer    Int?
  sjabloon      String // persluchtlekken | arbeidsmiddelen | markering (lib/inspecties/sjablonen.ts)
  klantId       Int
  objectId      Int
  installatieId Int? // optioneel: de installatie waar de hele inspectie over gaat
  datum         DateTime // dag van de inspectie
  uitvoerder    String
  status        String    @default("concept") // concept | afgerond
  samenvatting  String?
  instellingen  Json? // per sjabloon, bijvoorbeeld druk, draaiuren en prijs per kWh
  // De volgende inspectie van het geheel. Bij arbeidsmiddelen heeft elk
  // arbeidsmiddel ook een eigen datum; de vroegste daarvan telt als volgende.
  volgendeOp    DateTime?
  afgerondOp    DateTime?
  afgerondDoor  String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  klant       Klant            @relation(fields: [klantId], references: [id], onDelete: Restrict)
  object      SampleObject     @relation(fields: [objectId], references: [id], onDelete: Restrict)
  installatie Installatie?     @relation(fields: [installatieId], references: [id], onDelete: SetNull)
  items       InspectieItem[]
  stops       SamplePlanStop[]

  @@unique([nummerJaar, volgnummer])
  @@index([klantId])
  @@index([objectId])
  @@index([installatieId])
  @@index([datum])
  @@index([deletedAt])
}

// Een bevinding in een inspectie: een lek, of een arbeidsmiddel met checklist.
model InspectieItem {
  id            Int       @id @default(autoincrement())
  inspectieId   Int
  volgorde      Int       @default(0)
  installatieId Int? // arbeidsmiddelen: het arbeidsmiddel uit de installaties
  titel         String // labelnummer van het lek, of naam van het arbeidsmiddel
  locatie       String?
  oordeel       String? // per sjabloon: prioriteit (lek) of uitslag (arbeidsmiddel)
  notitie       String?
  waarden       Json? // meetwaarden en checklist, per sjabloon
  fotoUrl       String? // vervallen: foto's staan in InspectieFoto (kolom blijft als terugval)
  gerepareerd   Boolean   @default(false)
  gerepareerdOp DateTime?
  volgendeOp    DateTime? // arbeidsmiddelen: datum van de volgende inspectie
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  inspectie   Inspectie       @relation(fields: [inspectieId], references: [id], onDelete: Cascade)
  installatie Installatie?    @relation(fields: [installatieId], references: [id], onDelete: SetNull)
  fotos       InspectieFoto[]

  @@index([inspectieId])
  @@index([installatieId])
  @@index([deletedAt])
}

// Foto's bij een bevinding, meerdere per bevinding (zoals DagrapportFoto).
model InspectieFoto {
  id         Int       @id @default(autoincrement())
  itemId     Int
  url        String
  bijschrift String?
  volgorde   Int       @default(0)
  deletedAt  DateTime? // weggehaald (zacht, Ongedaan maken kan)
  deletedBy  String?
  createdAt  DateTime  @default(now())

  item InspectieItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// ============================================
// EIGEN DOSSIER (fase 4, alleen admin)
// ============================================
// Documenten van It's Done Services zelf: VCA, verzekering, KvK-uittreksel,
// diploma's en cursussen (deskundigheidsdossier) en kalibratie van
// meetmiddelen. Met vervaldatum; de geldige documenten gaan met één knop in
// een inhuurdossier (PDF). Het bestand staat in Blob onder een onvindbare naam
// en gaat alleen via de server naar de browser.

model EigenDocument {
  id          Int       @id @default(autoincrement())
  soort       String // vca | verzekering | kvk | diploma | cursus | kalibratie | overig (lib/eigenDossier.ts)
  titel       String
  uitgever    String?
  nummer      String?
  afgegevenOp DateTime?
  vervaltOp   DateTime? // leeg = verloopt niet
  bestandUrl  String?
  bestandNaam String?
  bestandType String?
  notities    String?
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vervaltOp])
  @@index([deletedAt])
}

// ============================================
// CONTRACTEN MET TERUGKERENDE TAKEN (fase 5)
// ============================================
// Per klant een contract (naam, looptijd, interne notities) met taken die
// terugkomen: oliemonsters, persluchtlekinspectie, inspectie arbeidsmiddelen,
// onderhoud of iets anders, op een object (en eventueel een installatie), elke
// zoveel maanden. `volgendeOp` is de eerstvolgende datum. Een uitvoering
// (ContractTaakUitvoering) zet die vanzelf door: met de hand (Uitgevoerd), een
// afgevinkte stop op de planning of een afgeronde inspectie van het passende
// sjabloon op dat object. De bron van een uitvoering is uniek per taak, zodat
// dezelfde inspectie twee keer afronden de datum niet twee keer doorzet
// (lib/contracten.ts).
//
// Notities op contract en taak zijn intern: het klantportaal toont alleen de
// soort, het object en de datum.

model Contract {
  id        Int       @id @default(autoincrement())
  klantId   Int
  naam      String
  startOp   DateTime? // begin van de looptijd (dag, 12:00 UTC)
  eindOp    DateTime? // einde van de looptijd; leeg = doorlopend
  notities  String? // intern
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  klant Klant          @relation(fields: [klantId], references: [id], onDelete: Restrict)
  taken ContractTaak[]

  @@index([klantId])
  @@index([deletedAt])
}

model ContractTaak {
  id                 Int       @id @default(autoincrement())
  contractId         Int
  soort              String // oliemonsters | persluchtlekken | arbeidsmiddelen | onderhoud | anders (lib/contracten.ts)
  omschrijving       String? // korte titel, bijvoorbeeld "Halfjaarlijks onderhoud aggregaat"
  objectId           Int
  installatieId      Int?
  intervalMaanden    Int // elke zoveel maanden
  volgendeOp         DateTime // eerstvolgende datum (dag, 12:00 UTC)
  geschatteMinuten   Int? // voor de planning; leeg = de standaard van de soort
  laatstUitgevoerdOp DateTime?
  notities           String? // intern
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  contract     Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  object       SampleObject             @relation(fields: [objectId], references: [id], onDelete: Restrict)
  installatie  Installatie?             @relation(fields: [installatieId], references: [id], onDelete: SetNull)
  uitvoeringen ContractTaakUitvoering[]
  stops        SamplePlanStop[]

  @@index([contractId])
  @@index([objectId])
  @@index([volgendeOp])
  @@index([deletedAt])
}

model ContractTaakUitvoering {
  id         Int      @id @default(autoincrement())
  taakId     Int
  datum      DateTime // dag van de uitvoering (12:00 UTC)
  // Waar de uitvoering vandaan komt: "hand-<tijd>", "stop-12" of "inspectie-7".
  // Uniek per taak, zodat een herhaling niets dubbel doorzet.
  bron       String
  // De datum die de taak vóór deze uitvoering had, om terug te kunnen zetten.
  vorigeOp   DateTime
  volgendeOp DateTime
  door       String?
  createdAt  DateTime @default(now())

  taak ContractTaak @relation(fields: [taakId], references: [id], onDelete: Cascade)

  @@unique([taakId, bron])
  @@index([taakId])
}

// ============================================
// DAGRAPPORT MET HANDTEKENING (fase 5)
// ============================================
// Bewijs van een bezoek: wat er gedaan is, bevindingen, foto's, uren en de
// handtekening van de klant op het scherm. Geen factuurbron (facturen blijven
// in Rompslomp). De handtekening staat als PNG (data-URL) in de database zelf:
// klein, en zo hoort hij onlosmakelijk bij het rapport. Een kijker met het
// klantportaal ziet alleen de getekende dagrapporten van zijn eigen klant.

model Dagrapport {
  id                 Int       @id @default(autoincrement())
  klantId            Int
  // Nummer WB-2026-001, zoals bij Inspectie (lib/nummering.ts).
  nummerJaar         Int?
  volgnummer         Int?
  planId             Int? // de planningsdag, als het bezoek daarvandaan kwam
  objectId           Int? // de plek van het bezoek (optioneel)
  datum              DateTime // dag van het bezoek (12:00 UTC)
  uitvoerder         String
  werkzaamheden      String?
  bevindingen        String?
  minuten            Int? // gewerkte tijd
  // Hoe de tijd is vastgelegd: uren (alleen een totaal), tijden (begin, eind en
  // pauze; minuten wordt daaruit berekend) of nvt (geen urenafspraak).
  tijdsoort          String    @default("uren")
  beginTijd          String? // 07:30
  eindTijd           String? // 16:00
  pauzeMinuten       Int?
  reisMinuten        Int?
  kilometers         Int?
  soortWerk          String? // onderhoud | storing | reparatie | inspectie | montage | oliemonsters | overig
  referentie         String? // werkorder-, order- of PO-nummer van de klant
  contactpersoon     String? // aanwezig namens de klant
  materialen         Json? // [{ omschrijving, aantal, eenheid, artikelnummer }]
  vervolgNodig       Boolean   @default(false)
  vervolgActie       String? // aanbeveling of wat er nog moet gebeuren
  // Vraagt deze werkbon een handtekening? Zonder handtekening wordt hij
  // afgerond (status afgerond) in plaats van getekend.
  handtekeningVragen Boolean   @default(true)
  afgerondOp         DateTime?
  status             String    @default("concept") // concept | afgerond | getekend
  handtekening       String? // data:image/png;base64,...
  getekendDoor       String? // naam van wie tekende
  getekendOp         DateTime?
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  klant  Klant            @relation(fields: [klantId], references: [id], onDelete: Restrict)
  plan   SamplePlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  object SampleObject?    @relation(fields: [objectId], references: [id], onDelete: SetNull)
  fotos  DagrapportFoto[]

  @@unique([nummerJaar, volgnummer])
  @@index([klantId])
  @@index([planId])
  @@index([datum])
  @@index([deletedAt])
}

model DagrapportFoto {
  id           Int      @id @default(autoincrement())
  dagrapportId Int
  url          String
  bijschrift   String?
  volgorde     Int      @default(0)
  createdAt    DateTime @default(now())

  dagrapport Dagrapport @relation(fields: [dagrapportId], references: [id], onDelete: Cascade)

  @@index([dagrapportId])
}

// ============================================
// AGENDAFEED (fase 5)
// ============================================
// Een geheime link per gebruiker waarop Apple Agenda zich abonneert (ICS). In
// de link staat `sleutel` plus een HMAC daarvan met SESSION_SECRET: de database
// alleen is dus niet genoeg om een geldige link te maken, en de link kan in de
// app opnieuw getoond worden. Intrekken = de regel weghalen.

model AgendaFeed {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  sleutel          String    @unique
  laatstGebruiktOp DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// VERZENDINGEN UIT DE OFFLINE WACHTRIJ (fase 5)
// ============================================
// Elke invoer uit de wachtrij (Monster nemen, een lek of arbeidsmiddel) komt
// met een eigen sleutel. De server bewaart het antwoord onder die sleutel: komt
// dezelfde invoer nog een keer binnen (verbinding viel weg vlak na het
// versturen), dan krijgt hij hetzelfde antwoord en gebeurt er niets dubbel
// (lib/idempotentie.ts). Regels ouder dan dertig dagen worden opgeruimd.

model Verzending {
  sleutel   String    @id
  userId    Int
  route     String
  status    Int?
  antwoord  Json?
  klaarOp   DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}
