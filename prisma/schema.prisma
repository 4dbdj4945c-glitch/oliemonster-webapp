// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int      @id @default(autoincrement())
  username               String   @unique
  password               String?  // Optioneel - null als wachtwoord nog niet gezet is
  role                   String   // "admin" of "user"
  requiresPasswordChange Boolean  @default(true)  // Moet gebruiker wachtwoord instellen?
  createdAt              DateTime @default(now())
}

model OilSample {
  id           Int      @id @default(autoincrement())
  oNumber      String   @unique  // o-nummer
  analysisYear Int      @default(2025)  // analyse-jaar (2025, 2026, ...)
  sampleDate   DateTime?         // cache: datum van de meest recente poging (SampleAttempt)
  location     String            // locatie
  description  String            // omschrijving
  oilType      String?           // type olie (optioneel)
  remarks      String?           // cache: opmerking van de meest recente poging
  isTaken      Boolean           // of er een geldig genomen monster is (true = groen, false = rood)
  isDisabled   Boolean  @default(false)  // monster is geannuleerd/niet nodig (grijze status)
  photoUrl     String?           // cache: foto van de meest recente poging
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts     SampleAttempt[]

  @@index([analysisYear])
}

// Per OilSample kunnen er meerdere monsternames (pogingen) zijn.
// Elke poging heeft eigen datum, foto en opmerking.
// De "meest recente" poging wordt als cache gespiegeld naar OilSample
// zodat bestaande lees-code gewoon blijft werken.
model SampleAttempt {
  id           Int       @id @default(autoincrement())
  oilSampleId  Int
  sampleDate   DateTime?            // datum afname; null = gepland maar nog niet genomen
  photoUrl     String?              // foto bewijsvoering voor deze poging
  remarks      String?              // opmerkingen specifiek voor deze poging
  isTaken      Boolean   @default(false)  // of deze poging daadwerkelijk is afgenomen
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  oilSample    OilSample @relation(fields: [oilSampleId], references: [id], onDelete: Cascade)

  @@index([oilSampleId])
  @@index([sampleDate])
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique  // Settings key (bijv. "theme", "columns")
  value     String              // JSON string met de settings waarde
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?                // Optioneel - bij login failures is er geen userId
  username   String              // Gebruikersnaam voor makkelijk filteren
  action     String              // Bijv. "LOGIN", "CREATE_SAMPLE", "DELETE_USER"
  details    String?             // JSON string met extra details
  ipAddress  String?             // IP adres van de request
  userAgent  String?             // Browser/device info
  success    Boolean  @default(true)  // Of de actie geslaagd is
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// VOORRAADBEHEER
// ============================================

model Product {
  id            Int      @id @default(autoincrement())
  brand         String              // Merk (bijv. "Shell", "Mann Filter")
  type          String              // Type (bijv. "Helix Ultra", "HU 716/2 x")
  articleNumber String?             // Artikelnummer (optioneel)
  category      String              // Categorie (bijv. "Filters", "Olie", "Vetten")
  location      String   @default("Hoofdmagazijn")  // Locatie waar product ligt
  unit          String   @default("stuks")  // Eenheid (stuks, liters, kg)
  minStock      Int      @default(0)        // Minimale voorraad voor waarschuwing
  description   String?             // Optionele omschrijving
  isActive      Boolean  @default(true)     // Of product actief is
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@index([category])
  @@index([brand])
  @@index([articleNumber])
}

model StockItem {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int      @default(0)   // Huidige voorraad
  location  String   @default("Hoofdmagazijn")  // Locatie van voorraad
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])  // Één stock item per product per locatie
  @@index([productId])
  @@index([location])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  type      String              // "IN" of "OUT"
  quantity  Int                 // Aantal (altijd positief)
  location  String   @default("Hoofdmagazijn")
  reason    String?             // Reden/opmerking
  userId    Int?                // Wie heeft de mutatie gedaan
  username  String?             // Gebruikersnaam voor referentie
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// CONTACTEN
// ============================================

model Contact {
  id        Int      @id @default(autoincrement())
  company   String              // Bedrijfsnaam
  name      String?             // Contactpersoon (optioneel)
  email     String?             // E-mailadres
  phone     String?             // Telefoonnummer
  address   String?             // Adres
  notes     String?             // Algemene notities
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactNotes ContactNote[]

  @@index([company])
  @@index([name])
}

model ContactNote {
  id        Int      @id @default(autoincrement())
  contactId Int
  content   String              // Inhoud van de notitie
  userId    Int?                // Wie heeft de notitie gemaakt
  username  String?             // Gebruikersnaam voor referentie
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

// ============================================
// ULTIMO-OPMERKINGEN
// ============================================
// Een onderhoudstaak (looprouteregel) keert periodiek terug onder dezelfde
// jobnaam, maar met telkens een nieuw jobnummer. De stabiele eenheid is dus
// jobnaam + taakomschrijving (+ installatie). Per cyclus plaats je daar een
// opmerking bij (UltimoComment). De velden lastDate/lastComment/lastJobNumber
// spiegelen de meest recente opmerking als cache, zodat de lijst snel laadt.

model UltimoTask {
  id              Int      @id @default(autoincrement())
  jobName         String              // Jobnaam (bijv. "Onderhoud pompen hal 2")
  taskDescription String              // Looprouteregel / taakomschrijving
  installation    String?             // Installatie / object (optioneel)
  lastDate        DateTime?           // cache: datum van de meest recente opmerking
  lastComment     String?             // cache: tekst van de meest recente opmerking
  lastJobNumber   String?             // cache: jobnummer van de meest recente opmerking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  comments        UltimoComment[]

  @@index([jobName])
  @@index([taskDescription])
}

model UltimoComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  date      DateTime?            // datum waarop je de opmerking plaatste
  jobNumber String?              // jobnummer van die cyclus (wisselt per keer)
  text      String               // de opmerking zoals in Ultimo geplaatst
  userId    Int?                 // wie de opmerking vastlegde
  username  String?              // gebruikersnaam voor referentie
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      UltimoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([date])
}
